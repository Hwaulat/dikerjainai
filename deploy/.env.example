# =================================================================
# KEFIR Derma Clinic Dashboard - Production Environment Configuration
# Location on VM: /opt/dockerapp/kefir-clinic-dashboard/.env
# =================================================================

# --- Container & Docker Compose Settings ---
# HOST: alamat bind server Node. Di docker-compose sudah di-set 0.0.0.0 (port hanya
# dibuka ke 127.0.0.1 host). Tanpa Docker + reverse proxy/tunnel, pakai 127.0.0.1.
HOST=0.0.0.0
PORT=3344
APP_PORT=3344
CONTAINER_NAME=kefir_clinic_dashboard
# Note: DOCKER_IMAGE_TAG is automatically bumped by the GitLab CI/CD deploy stage
DOCKER_IMAGE_TAG=registry.gitlab.com/dev-ragdalion/kefir-clinic-dashboard:latest
NODE_ENV=production
TZ=Asia/Jakarta

# --- Penyimpanan PostgreSQL (opsional; kosongkan = tetap berkas JSON di data/) ---
# STORAGE_BACKEND=postgres + DATABASE_URL: dokumen data/*.json disimpan di PostgreSQL.
# Saat DATABASE_URL terisi, migrasi skema (prisma migrate deploy) dijalankan otomatis
# pada setiap container start lewat docker-entrypoint.sh.
# Skema dikelola Prisma:  npm run db:deploy   (prisma migrate deploy)
# Impor data pertama:     npm run db:migrate  (node scripts/pg_migrate.js --verify, aman diulang)
# Format URL untuk Prisma: postgresql://USER:PASS@HOST:5432/DB (sertakan USER)
STORAGE_BACKEND=
DATABASE_URL=
# Opsional: set true jika ingin otomatis impor data/*.json ke PostgreSQL saat container start
AUTO_MIGRATE_DATA=false
# Dipakai service postgres di docker-compose (profile 'db')
POSTGRES_PASSWORD=

# --- Authentication & Session Security ---
# Secret key used to sign session cookies/tokens (generate with: openssl rand -hex 32)
KEFIR_SESSION_SECRET=

# --- Neosoft Cloud API Integration ---
# Bearer token for Neosoft Cloud API sync worker (scripts/sync_neosoft.py)
NEOSOFT_TOKEN=
# Alternatif: path file berisi token. Urutan baca scripts/sync_neosoft.py:
# data/neosoft_db/token.txt -> NEOSOFT_TOKEN_FILE -> NEOSOFT_TOKEN
NEOSOFT_TOKEN_FILE=

# --- AI Assistant / LLM Gateway (NineRouter) ---
# If running on the host VM, use host.docker.internal or local loopback
# NINEROUTER_HOST boleh berupa hostname (http, port NINEROUTER_PORT) ATAU URL lengkap,
# mis. https://9router.example.com/v1  (atau pakai NINEROUTER_BASE_URL).
NINEROUTER_HOST=host.docker.internal
NINEROUTER_PORT=20129
NINEROUTER_MODEL=utama
NINEROUTER_API_KEY=

# --- Meta Ads & Instagram Marketing API ---
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

# --- Google Maps & Business Reviews API ---
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Spreadsheet List BHP (standar BHP, kategori treatment, isi kemasan) ---
# ID atau URL Google Sheets. Dibaca sync_google_sheets.py (akses "Anyone with the link: Viewer")
# dan ditampilkan sebagai link "Isi di spreadsheet" di Master Treatment & Standar BHP.
BHP_SHEET_ID=

# --- Google Sheet Bukti Pembayaran (sheet_writer.js) ---
PAYMENT_SHEET_ID=
PAYMENT_SHEET_NAME=
# Path file JSON service account (di dalam container, mis. /app/data/google_sa.json)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Telegram Notifications & Broadcast Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tidak lewat env ---
# WhatsApp  : scan QR lewat dashboard; sesi di wa_assistant_auth/ (satu server saja per sesi)
# Gaji.id   : login lewat tab HR; tersimpan di data/gaji_id_settings.json
# Python    : sync Neosoft butuh python3 + paket di requirements.txt
