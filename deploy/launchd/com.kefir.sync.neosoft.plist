<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kefir.sync.neosoft</string>

    <!-- Sync dulu, lalu deteksi perpindahan grade dari data terbaru.
         Dijalankan berurutan lewat sh -c supaya pelacak tidak pernah
         membaca data yang belum diperbarui. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/usr/bin/python3 /Users/mymac/kefir-clinic-dashboard/scripts/sync_neosoft.py; /usr/bin/env node /Users/mymac/kefir-clinic-dashboard/scripts/track_grade_changes.js</string>
    </array>

    <!-- Repo utama, BUKAN worktree — supaya sync tetap hidup
         walau worktree audit dihapus -->
    <key>WorkingDirectory</key>
    <string>/Users/mymac/kefir-clinic-dashboard</string>

    <key>StartInterval</key>
    <integer>600</integer>

    <!-- Kejar jadwal yang terlewat saat Mac tidur / baru menyala -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mymac/kefir-clinic-dashboard/logs/sync-neosoft.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mymac/kefir-clinic-dashboard/logs/sync-neosoft.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <!-- Sync gagal TIDAK di-restart membabi buta; interval berikutnya
         yang mencoba lagi, supaya API Neosoft tidak dihujani permintaan -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
